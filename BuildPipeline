pipeline {
    agent any
    
      environment {
        RCLONE_CONFIG = "C:\\Users\\Administrator\\AppData\\Roaming\\rclone\\rclone.conf"
        BUILD_NAME = "WorldSoul_Build_Develop_"
        FOLDER_ID = ''
        GITHUB_USER = ''
        GITHUB_TOKEN = ''
        UE_PATH = 'E:\\Epic Games\\UE_5.8'
        WS_PATH = 'E:\\WorldSoul'
        INCR_MAJOR = 'false'
        INCR_MINOR = 'false'
        INCR_PATCH = 'true'
    }

    stages {
        stage('Pull World Soul') {
            steps {
                ws(env.WS_PATH) {
                powershell '''
                    if (!(Test-Path -Path $env:WS_PATH\\WorldSoul\\))
                    {
                        git clone -b develop https://$env:GITHUB_USER:$env:GITHUB_TOKEN@github.com/WolfPackGameDesign/WorldSoul.git
                    }
                    else
                    {
                        cd $env:WS_PATH\\WorldSoul
                        git fetch origin develop
                        git checkout develop
                        git pull origin develop
                    } 
                    '''
                }
            }
        }
        stage('Generate Project Files World Soul'){
            steps {
                ws(env.WS_PATH)
                {
                    powershell '''
                    & "$env:UE_PATH\\Engine\\Binaries\\DotNET\\UnrealBuildTool\\Unrealbuildtool.exe" `
                    -projectfiles `
                    -project="$env:WS_PATH\\WorldSoul\\WorldSoul.uproject" `
                    -game `
                    -rocket `
                    -progress
                    '''

                }
            }
        }
        stage('Build World Soul'){
            steps {
                ws(env.WS_PATH)
                {
                    powershell '''
                    & "$env:UE_PATH\\Engine\\Build\\BatchFiles\\RunUAT.bat" `
                    -ScriptsForProject="$env:WS_PATH\\WorldSoul\\WorldSoul.uproject" `
                    BuildCookRun `
                    -nop4 `
                    -utf8output `
                    -cook `
                    -project="$env:WS_PATH\\WorldSoul\\WorldSoul.uproject" `
                    -target=WorldSoul `
                    -unrealexe="$env:UE_PATH\\Engine\\Binaries\\Win64\\UnrealEditor-Cmd.exe" `
                    -platform=Win64 `
                    -stage `
                    -archive `
                    -package `
                    -build `
                    -pak `
                    -iostore `
                    -compressed `
                    -prereqs `
                    -archivedirectory="$env:WS_PATH\\WorldSoul\\temp\\Development" `
                    -clientconfig=Development `
                    -nocompileuat `
                    -clean
                    '''
                }
            }
        }
        stage('Increment Build Version'){
            steps {
                ws(env.WS_PATH)
                {
                    powershell '''

                    [bool]$incrMajor = [System.Convert]::ToBoolean($env:INCR_MAJOR)
                    [bool]$incrMinor = [System.Convert]::ToBoolean($env:INCR_MINOR)
                    [bool]$incrPatch = [System.Convert]::ToBoolean($env:INCR_PATCH)

                    $BuildVersion = cat $env:WS_PATH\\WorldSoul\\BuildVersion.txt
                    $BuildVersionArray = $BuildVersion.Split('.')

                    if($incrMajor)
                    {
                        $Major = [int]$BuildVersionArray[0] + [int]1
                    }
                    else
                    {
                        $Major = $BuildVersionArray[0] 
                    }

                    if($incrMinor)
                    {
                        $Minor = $BuildVersionArray[1] + [int]1
                    }
                    else
                    {
                        $Minor = $BuildVersionArray[1]
                    }

                    if($incrPatch)
                    {
                        $Patch = [int]$BuildVersionArray[2] + [int]1
                    }
                    else
                    {
                        $Patch = $BuildVersionArray[2]
                    }

                    $BuildVersion = $Major + '.' + $Minor + '.' + $Patch

                    $BuildVersion > $env:WS_PATH\\WorldSoul\\BuildVersion.txt
                   
                    '''
                }
            }
        }
    
        stage('Zip Build and Upload To Google Drive'){
            steps {
                ws(env.WS_PATH)
                {
                    powershell '''
                    $BuildVersion = cat $env:WS_PATH\\WorldSoul\\BuildVersion.txt
                    $BuildName = "$env:BUILD_NAME$(Get-Date -Format 'yyyyMMdd')_$BuildVersion"    
                    
                    whoami
                    C:\\rclone.exe config file
                    compress-Archive `
                            -Path "$env:WS_PATH\\WorldSoul\\temp\\Development\\*" `
                            -DestinationPath "$env:WS_PATH\\WorldSoul\\temp\\Development\\$BuildName.zip" `
                            -Force
                    C:\\rclone.exe copy `
                    "$env:WS_PATH\\WorldSoul\\temp\\Development\\$BuildName.zip" `
                    "WS:" `
                    --config $env:RCLONE_CONFIG `
                    --drive-root-folder-id $env:FOLDER_ID
                    '''
                }
            }
        }
    }
}
